# ==============================================================================
# Google Analytics 4 & Google Tag Manager Configuration
# ==============================================================================

# Google Analytics 4 Measurement ID (Format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager Container ID (Format: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Environment Identifier (development | staging | production)
NEXT_PUBLIC_APP_ENV=development

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anonymous API Key (used for client-side data fetching)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (Server-only / scripts, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
