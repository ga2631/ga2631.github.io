FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm install

# Copy project files
COPY . .

# Expose Next.js dev server port
EXPOSE 3000

# Run Next.js dev server with automatic dependency sync and host flag for Docker networking
CMD ["sh", "-c", "npm install && npm run dev -- -H 0.0.0.0 -p 3000"]

